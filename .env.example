# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par git).

# Supabase : Project Settings > API (ou la sortie de `npx supabase start` en local)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (« publishable key », ou ancienne « anon key ») : protégée par la RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clé secrète (« secret key », ou ancienne « service_role key »).
# Utilisée UNIQUEMENT par le script `npm run creer-admin`, jamais par l'application.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Géocodage (facultatif) : service d'adresses de l'IGN / Base Adresse Nationale
# GEOCODAGE_URL=https://data.geopf.fr/geocodage

# Tournées (facultatif) : clé OpenRouteService, pour l'ordre, l'itinéraire et les temps en voiture sur les routes.
# Sans clé, tout est calculé à vol d'oiseau. Clé gratuite : https://openrouteservice.org
# ORS_API_KEY=
# Adresse du service (par défaut https://api.heigit.org/openrouteservice)
# ORS_URL=

# Espace client : e-mails d'alerte à l'équipe (Brevo, gratuit). Sans ces réglages, aucune alerte n'est envoyée.
# BREVO_API_KEY=xkeysib-...
# Adresse d'envoi, vérifiée dans Brevo (idéalement sur votre nom de domaine)
# EMAIL_EXPEDITEUR=commandes@votre-domaine.fr
# EMAIL_NOM_EXPEDITEUR=Paniers
# Qui reçoit les alertes (plusieurs adresses séparées par des virgules)
# EMAIL_ALERTES=vous@exemple.fr
# Adresse publique du site, pour les liens des e-mails (sur Netlify, l'adresse principale est prise toute seule)
# SITE_URL=https://votre-domaine.fr

# Tests de la base (facultatif) : serveur Postgres où créer des bases jetables
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
